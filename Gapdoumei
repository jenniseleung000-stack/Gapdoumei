                        <span id="authErrorMsg"></span>
                    </div>

                    <button type="submit" id="authSubmitBtn" 
                        class="w-full bg-macaron-mint hover:bg-emerald-300 text-teal-900 font-bold py-3.5 px-4 rounded-2xl shadow-sm transition flex items-center justify-center gap-2 text-sm">
                        <span>進入朋友圈</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </section>

        <!-- VIEW 2: MAIN GROUP DASHBOARD -->
        <main id="mainSection" class="hidden space-y-5">
            
            <!-- TOP EVENT BAR / SWITCHER -->
            <div class="bg-white rounded-3xl p-4 shadow-sm border border-slate-100/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3 flex-grow">
                    <div class="bg-macaron-lavender text-indigo-700 px-3.5 py-2 rounded-2xl text-xs font-bold uppercase tracking-wider shrink-0 hidden sm:block">
                        目前活動
                    </div>
                    <div class="relative flex-grow">
                        <select id="eventSelect" class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-sm font-bold rounded-2xl px-4 py-3 pr-8 appearance-none focus:ring-2 focus:ring-macaron-mint outline-none cursor-pointer">
