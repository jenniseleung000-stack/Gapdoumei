                        </select>
                        <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xs"></i>
                    </div>
                </div>

                <button id="btnCreateEvent" class="bg-macaron-mintLight hover:bg-macaron-mint text-teal-800 font-bold px-4 py-3 rounded-2xl border border-emerald-100 text-xs transition flex items-center justify-center gap-2 shrink-0 shadow-sm">
                    <i class="fa-solid fa-plus"></i>
                    <span>新增聚會活動</span>
                </button>
            </div>

            <!-- EVENT CONTENT (When Events Exist) -->
            <div id="eventContent" class="space-y-5">
                
                <!-- MEMBER SELECTOR & STATUS QUICK TOOLBAR -->
                <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-100/80 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
                        <div>
