                    </div>

                    <!-- Legend -->
                    <div class="flex flex-wrap items-center justify-between text-xs gap-2 text-slate-600 bg-slate-50/70 p-3 rounded-2xl border border-slate-100">
                        <span class="font-bold text-slate-700">點擊月曆日期切換狀態：</span>
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-macaron-mint border border-teal-300"></span> 🟢 全日 OK</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-sky-300 border border-sky-400"></span> 🌗 半日 OK</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-macaron-butter border border-amber-300"></span> 🟡 唔確定</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-macaron-rose border border-rose-300"></span> 🔴 唔得</span>
                        </div>
                    </div>
                </div>

                <!-- CALENDAR CONTROL & QUICK JUMPS (Oct 2026 - Dec 2027) -->
                <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-100/80 space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <button id="btnPrevMonth" class="p-2 hover:bg-slate-100 rounded-xl text-slate-600 transition">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <h3 id="calendarMonthTitle" class="text-base sm:text-lg font-bold text-slate-800 min-w-[130px] text-center">
                                2026 年 10 月
