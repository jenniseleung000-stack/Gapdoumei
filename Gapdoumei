                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Group 密碼 / PIN</label>
                        <input type="password" id="inputGroupPin" required placeholder="輸入簡單密碼或 4 位 PIN" 
                            class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:ring-2 focus:ring-macaron-mint focus:border-emerald-300 outline-none text-slate-800 text-sm transition bg-slate-50/50">
                    </div>

                    <div id="authError" class="hidden text-xs text-rose-600 font-medium bg-macaron-roseLight p-3 rounded-2xl border border-rose-100 flex items-center gap-2">
