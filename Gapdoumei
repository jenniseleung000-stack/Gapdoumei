<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>夾到未 - 專屬夾日子工具</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter & Noto Sans TC -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        macaron: {
                            mint: '#A8E6CF',
                            mintLight: '#E8F8F2',
                            mintDark: '#38A37F',
                            lavender: '#E0E7FF',
                            lavenderDark: '#6366F1',
                            butter: '#FEF08A',
                            butterLight: '#FEFCE8',
                            butterDark: '#D97706',
                            rose: '#FECDD3',
                            roseLight: '#FFF1F2',
                            roseDark: '#E11D48',
                            cream: '#FAF8F5'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans TC', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #FAF8F5;
            -webkit-tap-highlight-color: transparent;
        }
        /* Soft custom scrollbar for matrix table */
        .custom-scrollbar::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #F1F5F9;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }
    </style>
</head>
<body class="bg-macaron-cream text-slate-700 min-h-screen flex flex-col antialiased selection:bg-macaron-mint flex flex-col">

    <!-- Main Container -->
    <div id="app" class="flex-grow flex flex-col max-w-4xl w-full mx-auto p-3 sm:p-6">
        
        <!-- Header -->
        <header class="flex items-center justify-between py-3 mb-4 border-b border-slate-200/80">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-macaron-mint to-teal-200 text-teal-800 rounded-2xl flex items-center justify-center font-black text-2xl shadow-sm border border-emerald-100">
                    🗓️
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-slate-800 tracking-tight flex items-center gap-2">
                        夾到未
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-macaron-mint text-teal-800">馬卡龍版</span>
                    </h1>
                    <p class="text-xs text-slate-400 font-medium">專屬朋友圈夾日子神器</p>
                </div>
            </div>
            <div id="userInfoHeader" class="hidden flex items-center gap-2 text-xs sm:text-sm">
                <span class="bg-macaron-lavender/60 text-slate-700 px-3.5 py-1.5 rounded-2xl border border-indigo-100 font-bold flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-users text-macaron-lavenderDark"></i>
                    <span id="headerGroupName">--</span>
                </span>
                <button id="logoutBtn" class="text-slate-400 hover:text-rose-500 p-2 rounded-xl hover:bg-rose-50 transition-colors" title="登出 / 切換 Group">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </div>
        </header>

        <!-- VIEW 1: AUTH / JOIN GROUP -->
        <section id="authSection" class="my-auto max-w-md w-full mx-auto py-8">
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100/80 space-y-6">
                <div class="text-center space-y-2">
                    <div class="w-16 h-16 bg-macaron-mintLight text-teal-600 rounded-3xl flex items-center justify-center mx-auto text-2xl border border-emerald-100">
                        <i class="fa-solid fa-people-group"></i>
                    </div>
                    <h2 class="text-xl font-bold text-slate-800">建立或進入朋友圈</h2>
                    <p class="text-xs text-slate-400 leading-relaxed max-w-xs mx-auto">同一個朋友圈只需開一次 Group，以後聚會隨時喺裡面開 Event 夾日子！</p>
                </div>

                <form id="authForm" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Group 名稱 (例如: 大專同學仔 / 班兄弟)</label>
                        <input type="text" id="inputGroupName" required placeholder="例如：大專六小強" 
